PORT=4000
# FRONTEND_ORIGIN acepta uno o mas dominios separados por coma.
# Ejemplo produccion: https://marble.example.com,https://www.marble.example.com
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL (base de datos "marmol" en pgAdmin)
# Si no se define, el backend usa almacenamiento en memoria.
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/marmol

# Auth / Tenant
AUTH_TOKEN_SECRET=dev-only-change-this-secret
ACCESS_TOKEN_TTL_SECONDS=43200
DEFAULT_WORKSHOP_ID=TLR-001

# Seed/migraciones de super admin (cambiar en produccion)
SUPER_ADMIN_ID=SUP-001
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@marmol.local
SUPER_ADMIN_PASSWORD=super123
SUPER_ADMIN_ROLE=Super Admin
SUPER_ADMIN_WORKSHOP_ID=TLR-001
