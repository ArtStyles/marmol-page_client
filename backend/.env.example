PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL (base de datos "marmol" en pgAdmin)
# Si no se define, el backend usa almacenamiento en memoria.
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/marmol

# Auth / Tenant
AUTH_TOKEN_SECRET=dev-only-change-this-secret
ACCESS_TOKEN_TTL_SECONDS=43200
DEFAULT_WORKSHOP_ID=TLR-001
